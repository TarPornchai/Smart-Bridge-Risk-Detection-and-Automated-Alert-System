{
    "scene_array": [
        {
            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{81c52d58-8611-45ad-adbd-ac8bf1ddceff}\",\n            \"in_index\": 0,\n            \"out_id\": \"{fe15d704-38b8-474c-9504-fdd46bd36533}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{4acd357f-844e-4411-b350-a2e3b105eaee}\",\n            \"in_index\": 0,\n            \"out_id\": \"{77fb6626-abf0-48f1-8a5e-e33cc9c70eb8}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{77fb6626-abf0-48f1-8a5e-e33cc9c70eb8}\",\n            \"in_index\": 0,\n            \"out_id\": \"{d2737e6a-07d5-49f5-964a-1e8647883331}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{df28bdd8-a233-4b1d-82e5-bfbc09193d22}\",\n            \"in_index\": 0,\n            \"out_id\": \"{213189ef-0bd3-405d-b35d-228494f62c31}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{d2737e6a-07d5-49f5-964a-1e8647883331}\",\n            \"in_index\": 0,\n            \"out_id\": \"{59c14e27-65d2-44c8-8fe4-99cf705503e2}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{213189ef-0bd3-405d-b35d-228494f62c31}\",\n            \"in_index\": 0,\n            \"out_id\": \"{df28bdd8-a233-4b1d-82e5-bfbc09193d22}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{4c7ff8e0-4481-48df-b4be-80599b7a782e}\",\n            \"in_index\": 0,\n            \"out_id\": \"{213189ef-0bd3-405d-b35d-228494f62c31}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{59c14e27-65d2-44c8-8fe4-99cf705503e2}\",\n            \"in_index\": 0,\n            \"out_id\": \"{213189ef-0bd3-405d-b35d-228494f62c31}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{fe15d704-38b8-474c-9504-fdd46bd36533}\",\n            \"in_index\": 0,\n            \"out_id\": \"{4c7ff8e0-4481-48df-b4be-80599b7a782e}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{213189ef-0bd3-405d-b35d-228494f62c31}\",\n            \"model\": {\n                \"data\": {\n                    \"filename\": \"C:/Users/Tar/Downloads/จับที่ราวสะพาน.mp4\",\n                    \"height\": 275,\n                    \"loop\": true,\n                    \"width\": 284\n                },\n                \"name\": \"VideoFile\",\n                \"node_enable\": false\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2318,\n                \"y\": 95\n            }\n        },\n        {\n            \"id\": \"{df28bdd8-a233-4b1d-82e5-bfbc09193d22}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2508,\n                \"y\": 114\n            }\n        },\n        {\n            \"id\": \"{1117f680-5b28-4585-91c5-9d1d3837efcd}\",\n            \"model\": {\n                \"flow_data_name\": \"a\",\n                \"name\": \"FlowDataSet\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": true\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -988,\n                \"y\": 1235\n            }\n        },\n        {\n            \"id\": \"{d2737e6a-07d5-49f5-964a-1e8647883331}\",\n            \"model\": {\n                \"data\": {\n                    \"count_key\": \"\",\n                    \"output_style\": \"both\",\n                    \"payload_key\": \"DeepDetect\",\n                    \"use_intersection\": true,\n                    \"zones\": [\n                        {\n                            \"alpha\": 0.3,\n                            \"color\": \"255,0,255\",\n                            \"filled\": true,\n                            \"thickness\": 3,\n                            \"zone_name\": \"Zone1\",\n                            \"zone_pts_str\": \"1022:704,624:2,1274:2,1272:694,655:686,688:561,953:584\"\n                        },\n                        {\n                            \"alpha\": 0.3,\n                            \"color\": \"182,255,0\",\n                            \"filled\": true,\n                            \"thickness\": 3,\n                            \"zone_name\": \"Zone2\",\n                            \"zone_pts_str\": \"270:699,453:5,594:2,930:702\"\n                        }\n                    ]\n                },\n                \"name\": \"ZoneCounterP\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -1976,\n                \"y\": 95\n            }\n        },\n        {\n            \"id\": \"{59c14e27-65d2-44c8-8fe4-99cf705503e2}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"from ultralytics import YOLO\\r\\nimport cv2\\r\\nimport numpy as np\\r\\nimport math\\r\\n\\r\\n# 1. โหลดโมเดล Pose (ตรวจจับคนและข้อต่อ) และโมเดล Detect (ตรวจจับรถยนต์/ยานพาหนะ)\\r\\nmodel_pose = YOLO(r'C:\\\\Users\\\\Tar\\\\Downloads\\\\Ultralytics\\\\PoseEstimation\\\\yolo26s-pose.pt')\\r\\nmodel_det = YOLO(r'C:\\\\Users\\\\Tar\\\\Downloads\\\\Ultralytics\\\\Detection\\\\yolo26n.pt')\\r\\n\\r\\nKEYPOINT_NAMES = {\\r\\n\\t0: \\\"nose\\\", 1: \\\"left_eye\\\", 2: \\\"right_eye\\\", 3: \\\"left_ear\\\", 4: \\\"right_ear\\\",\\r\\n\\t5: \\\"left_shoulder\\\", 6: \\\"right_shoulder\\\", 7: \\\"left_elbow\\\", 8: \\\"right_elbow\\\",\\r\\n\\t9: \\\"left_wrist\\\", 10: \\\"right_wrist\\\", 11: \\\"left_hip\\\", 12: \\\"right_hip\\\",\\r\\n\\t13: \\\"left_knee\\\", 14: \\\"right_knee\\\", 15: \\\"left_ankle\\\", 16: \\\"right_ankle\\\"\\r\\n}\\r\\n\\r\\n# คลาสยานพาหนะใน COCO Dataset: 2=car, 3=motorcycle, 5=bus, 7=truck\\r\\nVEHICLE_CLASSES = [2, 3, 5, 7]\\r\\n\\r\\ndef check_person_fallen(box_xyxy, kpts, kpts_conf):\\r\\n\\t\\\"\\\"\\\"ตรวจสอบว่าบุคคลมีท่าทางล้มนอน/เป็นลมกับพื้นหรือไม่\\\"\\\"\\\"\\r\\n\\tx1, y1, x2, y2 = box_xyxy\\r\\n\\tw = max(1.0, float(x2 - x1))\\r\\n\\th = max(1.0, float(y2 - y1))\\r\\n\\taspect_ratio = w / h\\r\\n\\r\\n\\t# เงื่อนไขที่ 1: กรอบตัวคนมีความกว้างมากกว่าความสูงชัดเจน (นอนราบ)\\r\\n\\tif aspect_ratio > 1.2:\\r\\n\\t\\treturn True\\r\\n\\r\\n\\t# เงื่อนไขที่ 2: เช็กมุมเอียงของลำตัว (ไหล่ เทียบกับ สะโพก/ข้อเท้า)\\r\\n\\tupper_pts = [kpts[i] for i in [0, 5, 6] if i < len(kpts) and kpts_conf[i] > 0.4 and kpts[i][0] > 0]\\r\\n\\tlower_pts = [kpts[i] for i in [11, 12, 15, 16] if i < len(kpts) and kpts_conf[i] > 0.4 and kpts[i][0] > 0]\\r\\n\\r\\n\\tif len(upper_pts) > 0 and len(lower_pts) > 0:\\r\\n\\t\\tux = np.mean([p[0] for p in upper_pts])\\r\\n\\t\\tuy = np.mean([p[1] for p in upper_pts])\\r\\n\\t\\tlx = np.mean([p[0] for p in lower_pts])\\r\\n\\t\\tly = np.mean([p[1] for p in lower_pts])\\r\\n\\r\\n\\t\\tdx = abs(ux - lx)\\r\\n\\t\\tdy = abs(uy - ly)\\r\\n\\t\\t# คำนวณมุมของลำตัวเทียบกับแนวนอน (องศา)\\r\\n\\t\\tangle_deg = math.degrees(math.atan2(dy, dx + 1e-5))\\r\\n\\t\\tif angle_deg < 32.0 and aspect_ratio > 0.95:\\r\\n\\t\\t\\treturn True\\r\\n\\r\\n\\treturn False\\r\\n\\r\\ndef handle_request(req):\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\tif img is None:\\r\\n\\t\\treturn makeRespData(payload, img)\\r\\n\\r\\n\\timg_np = np.ascontiguousarray(np.array(img, dtype=np.uint8))\\r\\n\\r\\n\\t# รันโมเดล Pose และโมเดลตรวจจับรถยนต์\\r\\n\\tresults_pose = model_pose(source=img_np, conf=0.35, verbose=False)\\r\\n\\tresults_det = model_det(source=img_np, conf=0.45, classes=VEHICLE_CLASSES, verbose=False)\\r\\n\\r\\n\\tannotated_img = results_pose[0].plot()\\r\\n\\r\\n\\tif \\\"DeepDetect\\\" not in payload:\\r\\n\\t\\tpayload[\\\"DeepDetect\\\"] = {}\\r\\n\\r\\n\\tobjects = []\\r\\n\\tbox_radius = 15\\r\\n\\r\\n\\t# --- ส่วนที่ A: ประมวลผลข้อต่อคน และตรวจจับการล้มนอน ---\\r\\n\\tif (results_pose[0].keypoints is not None and len(results_pose[0].keypoints.xy) > 0 and\\r\\n\\t\\t\\tresults_pose[0].boxes is not None and len(results_pose[0].boxes.xyxy) > 0):\\r\\n\\r\\n\\t\\tkeypoints_xy = results_pose[0].keypoints.xy.cpu().numpy()\\r\\n\\t\\tkeypoints_conf = results_pose[0].keypoints.conf.cpu().numpy()\\r\\n\\t\\tboxes_xyxy = results_pose[0].boxes.xyxy.cpu().numpy()\\r\\n\\t\\tboxes_conf = results_pose[0].boxes.conf.cpu().numpy()\\r\\n\\r\\n\\t\\tfor person_idx, kpts in enumerate(keypoints_xy):\\r\\n\\t\\t\\tif person_idx >= len(boxes_xyxy):\\r\\n\\t\\t\\t\\tbreak\\r\\n\\r\\n\\t\\t\\tp_box = boxes_xyxy[person_idx]\\r\\n\\t\\t\\tp_conf = float(boxes_conf[person_idx])\\r\\n\\t\\t\\tk_conf_arr = keypoints_conf[person_idx]\\r\\n\\r\\n\\t\\t\\t# 1. เช็กว่าคนนี้ล้มนอน/เป็นลมหรือไม่\\r\\n\\t\\t\\tis_fallen = check_person_fallen(p_box, kpts, k_conf_arr)\\r\\n\\t\\t\\tif is_fallen:\\r\\n\\t\\t\\t\\tfx1, fy1, fx2, fy2 = map(int, p_box)\\r\\n\\t\\t\\t\\tcx, cy = (fx1 + fx2) // 2, (fy1 + fy2) // 2\\r\\n\\t\\t\\t\\tcv2.rectangle(annotated_img, (fx1, fy1), (fx2, fy2), (255, 0, 255), 3)\\r\\n\\t\\t\\t\\tcv2.putText(annotated_img, \\\"FALLEN / FAINTED!\\\", (fx1, max(20, fy1 - 10)),\\r\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 0, 255), 2)\\r\\n\\r\\n\\t\\t\\t\\t# ส่งวัตถุ person_fallen (จุดกึ่งกลางตัวคน) เข้าไปให้ ZoneCounterP เช็กใน Zone2\\r\\n\\t\\t\\t\\tobjects.append({\\r\\n\\t\\t\\t\\t\\t\\\"name\\\": \\\"person_fallen\\\",\\r\\n\\t\\t\\t\\t\\t\\\"prob\\\": round(p_conf, 2),\\r\\n\\t\\t\\t\\t\\t\\\"x\\\": max(0, cx - 20),\\r\\n\\t\\t\\t\\t\\t\\\"y\\\": max(0, cy - 20),\\r\\n\\t\\t\\t\\t\\t\\\"w\\\": 40,\\r\\n\\t\\t\\t\\t\\t\\\"h\\\": 40\\r\\n\\t\\t\\t\\t})\\r\\n\\r\\n\\t\\t\\t# 2. ส่งจุดข้อต่อทั้ง 17 จุดให้ ZoneCounterP เช็กใน Zone1 (ราวสะพาน)\\r\\n\\t\\t\\tfor kpt_idx, label_name in KEYPOINT_NAMES.items():\\r\\n\\t\\t\\t\\tif kpt_idx >= len(kpts):\\r\\n\\t\\t\\t\\t\\tcontinue\\r\\n\\t\\t\\t\\tconf = float(k_conf_arr[kpt_idx])\\r\\n\\t\\t\\t\\tx, y = kpts[kpt_idx]\\r\\n\\r\\n\\t\\t\\t\\tif conf > 0.4 and x > 0 and y > 0:\\r\\n\\t\\t\\t\\t\\tcolor = (0, 0, 255) if kpt_idx in [9, 10] else (0, 255, 0)\\r\\n\\t\\t\\t\\t\\tcv2.circle(annotated_img, (int(x), int(y)), 5, color, -1)\\r\\n\\r\\n\\t\\t\\t\\t\\tobjects.append({\\r\\n\\t\\t\\t\\t\\t\\t\\\"name\\\": label_name,\\r\\n\\t\\t\\t\\t\\t\\t\\\"prob\\\": round(conf, 2),\\r\\n\\t\\t\\t\\t\\t\\t\\\"x\\\": max(0, int(x - box_radius)),\\r\\n\\t\\t\\t\\t\\t\\t\\\"y\\\": max(0, int(y - box_radius)),\\r\\n\\t\\t\\t\\t\\t\\t\\\"w\\\": box_radius * 2,\\r\\n\\t\\t\\t\\t\\t\\t\\\"h\\\": box_radius * 2\\r\\n\\t\\t\\t\\t\\t})\\r\\n\\r\\n\\t# --- ส่วนที่ B: ประมวลผลรถยนต์/ยานพาหนะ ---\\r\\n\\tif results_det[0].boxes is not None and len(results_det[0].boxes.xyxy) > 0:\\r\\n\\t\\tv_boxes = results_det[0].boxes.xyxy.cpu().numpy()\\r\\n\\t\\tv_confs = results_det[0].boxes.conf.cpu().numpy()\\r\\n\\r\\n\\t\\tfor vbox, vconf in zip(v_boxes, v_confs):\\r\\n\\t\\t\\tvx1, vy1, vx2, vy2 = map(int, vbox)\\r\\n\\t\\t\\tcv2.rectangle(annotated_img, (vx1, vy1), (vx2, vy2), (0, 255, 255), 3)\\r\\n\\t\\t\\tcv2.putText(annotated_img, f\\\"VEHICLE {vconf:.2f}\\\", (vx1, max(20, vy1 - 10)),\\r\\n\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)\\r\\n\\r\\n\\t\\t\\tobjects.append({\\r\\n\\t\\t\\t\\t\\\"name\\\": \\\"vehicle\\\",\\r\\n\\t\\t\\t\\t\\\"prob\\\": round(float(vconf), 2),\\r\\n\\t\\t\\t\\t\\\"x\\\": max(0, vx1),\\r\\n\\t\\t\\t\\t\\\"y\\\": max(0, vy1),\\r\\n\\t\\t\\t\\t\\\"w\\\": max(1, vx2 - vx1),\\r\\n\\t\\t\\t\\t\\\"h\\\": max(1, vy2 - vy1)\\r\\n\\t\\t\\t})\\r\\n\\r\\n\\tpayload[\\\"DeepDetect\\\"][\\\"objects\\\"] = objects\\r\\n\\treturn makeRespData(payload, annotated_img)\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/Tar/.local/bin/python3.14.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2128,\n                \"y\": 95\n            }\n        },\n        {\n            \"id\": \"{9b5a31cf-23df-4249-8f4a-0253fcb40a30}\",\n            \"model\": {\n                \"data\": {\n                    \"bold\": true,\n                    \"flow_data\": \"a\",\n                    \"font\": \"Ubuntu\",\n                    \"height\": 456,\n                    \"init_color\": \"#a5860b\",\n                    \"js_code\": \"var count = 0;\\n\\nif (payload && payload.ZoneCounterP && payload.ZoneCounterP.Zone1) {\\n\\tvar val = payload.ZoneCounterP.Zone1.right_wrist;\\n\\tcount = (typeof val === 'object') ? (val.count || 0) : (val || 0);\\n}\\n\\nvar led_color = \\\"green\\\";\\n\\nif (count > 0) {\\n\\tled_color = \\\"red\\\";\\n} else {\\n\\tled_color = \\\"green\\\";\\n}\\n\\nled = (val) ? 'red':'green'\\n\\nprint(\\\"hand_on_rail: \\\" + count + \\\" | led: \\\" + led_color);\\n\\n\",\n                    \"led\": \"#00ff00\",\n                    \"size\": 18,\n                    \"tab_index\": 1,\n                    \"text\": \"led\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        },\n                        \"splt0\": 332,\n                        \"splt1\": 83\n                    },\n                    \"width\": 550\n                },\n                \"height\": 257,\n                \"name\": \"LED\",\n                \"width\": 205\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": true\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -874,\n                \"y\": 1026\n            }\n        },\n        {\n            \"id\": \"{77fb6626-abf0-48f1-8a5e-e33cc9c70eb8}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"import time\\r\\nimport threading\\r\\nimport os\\r\\nfrom collections import deque\\r\\nimport cv2\\r\\nimport numpy as np\\r\\nimport requests\\r\\n\\r\\n# ================= ตั้งค่าระบบเชื่อมต่อ =================\\r\\nDISCORD_WEBHOOK_URL = \\\"https://discord.com/api/webhooks/1574981821609934898/Fkye7V7yum891WsLuHGsMzpH0Otwng85XCuDypCnAdubOnb67Vanim-kAMy9cNT0JoFq\\\"\\r\\nSERVER_LIVE_URL = \\\"http://127.0.0.1:8000/api/live\\\"\\r\\nSERVER_INCIDENT_URL = \\\"http://127.0.0.1:8000/api/incident\\\"\\r\\nCAPTURE_DIR = r\\\"C:\\\\Users\\\\Tar\\\\Desktop\\\\BridgeDemo\\\\captures\\\"\\r\\nos.makedirs(CAPTURE_DIR, exist_ok=True)\\r\\n\\r\\nPOLE_ID = \\\"เสา P8-N04 (ฝั่งพระนคร)\\\"\\r\\nWARNING_HOLD_SEC = 1.0      # หัวไหล่ทั้ง 2 ข้างเข้า Zone1 เกิน 1 วินาที -> เฝ้าระวัง (WARNING)\\r\\nESCALATE_DANGER_SEC = 6.0   # หัวไหล่ทั้ง 2 ข้างค้างใน Zone1 เกิน 6 วินาที -> อันตราย (DANGER)\\r\\nFALLEN_HOLD_SEC = 2.0       # นอนราบกับพื้นใน Zone2 เกิน 2 วินาที -> ผู้หมดสติ (FALLEN)\\r\\nALERT_COOLDOWN = 15.0       # หน่วงเวลาส่งแจ้งเตือนซ้ำ (วินาที)\\r\\n\\r\\n# เฉพาะหัวไหล่ทั้ง 2 ข้าง และช่วงล่าง (ตัดส่วนแขนและศีรษะออกทั้งหมด)\\r\\nSHOULDER_PARTS = {\\\"left_shoulder\\\", \\\"right_shoulder\\\"}\\r\\nLOWER_PARTS = {\\\"left_hip\\\", \\\"right_hip\\\", \\\"left_knee\\\", \\\"right_knee\\\", \\\"left_ankle\\\", \\\"right_ankle\\\"}\\r\\n# =====================================================\\r\\n\\r\\nz1_enter_time = None\\r\\nfallen_enter_time = None\\r\\nlast_alert_times = {\\\"VEHICLE\\\": 0, \\\"FALLEN\\\": 0, \\\"DANGER\\\": 0, \\\"WARNING\\\": 0}\\r\\nlast_stream_time = 0\\r\\nframe_buffer = deque(maxlen=60)\\r\\n\\r\\ndef send_live_stream_async(jpg_bytes, risk_level, parts_text, duration):\\r\\n\\ttry:\\r\\n\\t\\trequests.post(\\r\\n\\t\\t\\tSERVER_LIVE_URL,\\r\\n\\t\\t\\tdata={\\r\\n\\t\\t\\t\\t\\\"risk_level\\\": risk_level,\\r\\n\\t\\t\\t\\t\\\"detected_parts\\\": parts_text,\\r\\n\\t\\t\\t\\t\\\"hold_duration\\\": round(duration, 2),\\r\\n\\t\\t\\t\\t\\\"pole_id\\\": POLE_ID\\r\\n\\t\\t\\t},\\r\\n\\t\\t\\tfiles={\\\"frame\\\": (\\\"frame.jpg\\\", jpg_bytes, \\\"image/jpeg\\\")},\\r\\n\\t\\t\\ttimeout=0.3\\r\\n\\t\\t)\\r\\n\\texcept Exception:\\r\\n\\t\\tpass\\r\\n\\r\\ndef record_and_alert_async(snapshot_img, buffered_frames, risk_level, event_desc, duration, send_discord):\\r\\n\\ttry:\\r\\n\\t\\tts_file = time.strftime(\\\"%Y%m%d_%H%M%S\\\")\\r\\n\\t\\tts_read = time.strftime(\\\"%Y-%m-%d %H:%M:%S\\\")\\r\\n\\t\\timg_name = f\\\"{risk_level.lower()}_{ts_file}.jpg\\\"\\r\\n\\t\\timg_path = os.path.join(CAPTURE_DIR, img_name)\\r\\n\\r\\n\\t\\tcv2.imwrite(img_path, snapshot_img)\\r\\n\\r\\n\\t\\tvid_name = \\\"\\\"\\r\\n\\t\\tif risk_level in [\\\"VEHICLE\\\", \\\"FALLEN\\\", \\\"DANGER\\\"] and len(buffered_frames) > 0:\\r\\n\\t\\t\\th, w, _ = buffered_frames[0].shape\\r\\n\\t\\t\\tvid_name = f\\\"{risk_level.lower()}_{ts_file}.webm\\\"\\r\\n\\t\\t\\tvid_path = os.path.join(CAPTURE_DIR, vid_name)\\r\\n\\t\\t\\tout_vid = cv2.VideoWriter(vid_path, cv2.VideoWriter_fourcc(*'VP80'), 12.0, (w, h))\\r\\n\\r\\n\\t\\t\\tif not out_vid.isOpened():\\r\\n\\t\\t\\t\\tvid_name = f\\\"{risk_level.lower()}_{ts_file}.mp4\\\"\\r\\n\\t\\t\\t\\tvid_path = os.path.join(CAPTURE_DIR, vid_name)\\r\\n\\t\\t\\t\\tout_vid = cv2.VideoWriter(vid_path, cv2.VideoWriter_fourcc(*'avc1'), 12.0, (w, h))\\r\\n\\r\\n\\t\\t\\tif out_vid.isOpened():\\r\\n\\t\\t\\t\\tfor f in buffered_frames:\\r\\n\\t\\t\\t\\t\\tout_vid.write(f)\\r\\n\\t\\t\\t\\tout_vid.release()\\r\\n\\t\\t\\telse:\\r\\n\\t\\t\\t\\tvid_name = \\\"\\\"\\r\\n\\r\\n\\t\\trequests.post(SERVER_INCIDENT_URL, json={\\r\\n\\t\\t\\t\\\"timestamp\\\": ts_read,\\r\\n\\t\\t\\t\\\"camera_id\\\": \\\"CAM-01\\\",\\r\\n\\t\\t\\t\\\"pole_id\\\": POLE_ID,\\r\\n\\t\\t\\t\\\"risk_level\\\": risk_level,\\r\\n\\t\\t\\t\\\"event_type\\\": event_desc,\\r\\n\\t\\t\\t\\\"duration\\\": duration,\\r\\n\\t\\t\\t\\\"snapshot_file\\\": img_name,\\r\\n\\t\\t\\t\\\"video_file\\\": vid_name\\r\\n\\t\\t}, timeout=2.0)\\r\\n\\r\\n\\t\\tif send_discord and DISCORD_WEBHOOK_URL.startswith(\\\"http\\\"):\\r\\n\\t\\t\\tif risk_level == \\\"VEHICLE\\\":\\r\\n\\t\\t\\t\\ttitle = \\\"🚗 **[แจ้งเหตุฉุกเฉิน] ตรวจพบรถยนต์รุกล้ำทางเดินสะพาน!**\\\"\\r\\n\\t\\t\\t\\tagency = \\\"ตำรวจจราจร / เจ้าหน้าที่ควบคุมการจราจรบนสะพาน\\\"\\r\\n\\t\\t\\telif risk_level == \\\"FALLEN\\\":\\r\\n\\t\\t\\t\\ttitle = \\\"🚑 **[แจ้งเหตุฉุกเฉินทางการแพทย์] พบผู้หมดสติ/ล้มนอนบนทางเดิน!**\\\"\\r\\n\\t\\t\\t\\tagency = \\\"หน่วยกู้ชีพ 1669 / เจ้าหน้าที่กู้ภัยประจำจุด\\\"\\r\\n\\t\\t\\telse:\\r\\n\\t\\t\\t\\ttitle = \\\"🚨 **[แจ้งเหตุอันตราย] บุคคลเสี่ยงพลัดตกสะพาน!**\\\"\\r\\n\\t\\t\\t\\tagency = \\\"เจ้าหน้าที่ตำรวจ / สายตรวจสะพาน\\\"\\r\\n\\r\\n\\t\\t\\tmsg = (\\r\\n\\t\\t\\t\\tf\\\"{title}\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"📍 **พิกัดจุดเกิดเหตุ:** `{POLE_ID}` (กล้อง `CAM-01`)\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"⚠️ **รายละเอียด:** {event_desc}\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"🚓 **หน่วยงานประสานงาน:** {agency}\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"🕒 **เวลา:** `{ts_read}`\\\"\\r\\n\\t\\t\\t)\\r\\n\\t\\t\\twith open(img_path, \\\"rb\\\") as f:\\r\\n\\t\\t\\t\\trequests.post(\\r\\n\\t\\t\\t\\t\\tDISCORD_WEBHOOK_URL,\\r\\n\\t\\t\\t\\t\\tdata={\\\"content\\\": msg},\\r\\n\\t\\t\\t\\t\\tfiles={\\\"file\\\": (img_name, f, \\\"image/jpeg\\\")},\\r\\n\\t\\t\\t\\t\\ttimeout=5.0\\r\\n\\t\\t\\t\\t)\\r\\n\\t\\tprint(f\\\"[{risk_level}] บันทึกและแจ้งเตือนสำเร็จ: {event_desc}\\\")\\r\\n\\texcept Exception as e:\\r\\n\\t\\tprint(\\\"[ERROR] Alert thread error:\\\", e)\\r\\n\\r\\ndef handle_request(req):\\r\\n\\tglobal z1_enter_time, fallen_enter_time, last_alert_times, last_stream_time\\r\\n\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\tif img is None:\\r\\n\\t\\treturn makeRespData(payload, img)\\r\\n\\r\\n\\tdisplay_img = np.ascontiguousarray(np.array(img, dtype=np.uint8)).copy()\\r\\n\\tobjects = payload.get(\\\"DeepDetect\\\", {}).get(\\\"objects\\\", [])\\r\\n\\r\\n\\tin_z1_shoulders = set()\\r\\n\\tin_z1_lower = set()\\r\\n\\tfallen_in_z2 = False\\r\\n\\tvehicle_in_z2 = False\\r\\n\\r\\n\\tfor obj in objects:\\r\\n\\t\\tzone_name = obj.get(\\\"zone\\\", \\\"Outside zone\\\")\\r\\n\\t\\tpart_name = obj.get(\\\"name\\\", \\\"\\\")\\r\\n\\r\\n\\t\\t# ตรวจสอบวัตถุใน Zone1 (นับเฉพาะหัวไหล่และช่วงล่าง ไม่นับแขน/มือ)\\r\\n\\t\\tif zone_name == \\\"Zone1\\\":\\r\\n\\t\\t\\tif part_name in LOWER_PARTS:\\r\\n\\t\\t\\t\\tin_z1_lower.add(part_name)\\r\\n\\t\\t\\telif part_name in SHOULDER_PARTS:\\r\\n\\t\\t\\t\\tin_z1_shoulders.add(part_name)\\r\\n\\r\\n\\t\\t# ตรวจสอบวัตถุใน Zone2 (ทางเดินเท้า)\\r\\n\\t\\telif zone_name == \\\"Zone2\\\":\\r\\n\\t\\t\\tif part_name == \\\"person_fallen\\\":\\r\\n\\t\\t\\t\\tfallen_in_z2 = True\\r\\n\\t\\t\\telif part_name == \\\"vehicle\\\":\\r\\n\\t\\t\\t\\tvehicle_in_z2 = True\\r\\n\\r\\n\\tnow = time.time()\\r\\n\\r\\n\\t# ต้องมีหัวไหล่ครบทั้ง 2 ข้าง (left_shoulder และ right_shoulder) อยู่ใน Zone1\\r\\n\\thas_both_shoulders = (\\\"left_shoulder\\\" in in_z1_shoulders) and (\\\"right_shoulder\\\" in in_z1_shoulders)\\r\\n\\r\\n\\t# 1. คำนวณเวลาโซนราวสะพาน (Zone1)\\r\\n\\tz1_duration = 0.0\\r\\n\\tif len(in_z1_lower) > 0 or has_both_shoulders:\\r\\n\\t\\tif z1_enter_time is None:\\r\\n\\t\\t\\tz1_enter_time = now\\r\\n\\t\\tz1_duration = now - z1_enter_time\\r\\n\\telse:\\r\\n\\t\\tz1_enter_time = None\\r\\n\\r\\n\\t# 2. คำนวณเวลาคนหมดสติ/ล้มนอนบนทางเดิน (Zone2)\\r\\n\\tfallen_duration = 0.0\\r\\n\\tif fallen_in_z2:\\r\\n\\t\\tif fallen_enter_time is None:\\r\\n\\t\\t\\tfallen_enter_time = now\\r\\n\\t\\tfallen_duration = now - fallen_enter_time\\r\\n\\telse:\\r\\n\\t\\tfallen_enter_time = None\\r\\n\\r\\n\\t# 3. จัดลำดับเหตุการณ์ (VEHICLE / FALLEN / DANGER / WARNING / NORMAL)\\r\\n\\trisk_level = \\\"NORMAL\\\"\\r\\n\\tevent_desc = \\\"เหตุการณ์ปกติ\\\"\\r\\n\\tactive_duration = 0.0\\r\\n\\tdetected_summary = []\\r\\n\\r\\n\\tif vehicle_in_z2:\\r\\n\\t\\trisk_level = \\\"VEHICLE\\\"\\r\\n\\t\\tevent_desc = \\\"แจ้งเตือนรถยนต์: ตรวจพบรถยนต์รุกล้ำเข้ามาบนทางเดินเท้า (Zone2)\\\"\\r\\n\\t\\tdetected_summary.append(\\\"Vehicle in Zone2\\\")\\r\\n\\telif fallen_in_z2 and fallen_duration >= FALLEN_HOLD_SEC:\\r\\n\\t\\trisk_level = \\\"FALLEN\\\"\\r\\n\\t\\tactive_duration = fallen_duration\\r\\n\\t\\tevent_desc = f\\\"พบผู้หมดสติ: ตรวจพบคนล้มนอนราบกับพื้นทางเดิน ({fallen_duration:.1f}s)\\\"\\r\\n\\t\\tdetected_summary.append(\\\"Person Fallen (Zone2)\\\")\\r\\n\\telif len(in_z1_lower) > 0:\\r\\n\\t\\trisk_level = \\\"DANGER\\\"\\r\\n\\t\\tactive_duration = z1_duration\\r\\n\\t\\tevent_desc = f\\\"ระดับอันตราย: พบส่วนสะโพก/ช่วงล่างข้ามแนวราวสะพาน ({', '.join(sorted(in_z1_lower))})\\\"\\r\\n\\t\\tdetected_summary.extend(sorted(list(in_z1_lower)))\\r\\n\\telif has_both_shoulders and z1_duration >= ESCALATE_DANGER_SEC:\\r\\n\\t\\trisk_level = \\\"DANGER\\\"\\r\\n\\t\\tactive_duration = z1_duration\\r\\n\\t\\tevent_desc = f\\\"ระดับอันตราย: ยื่นหัวไหล่ทั้ง 2 ข้างเกินราวสะพานนานเกิน {ESCALATE_DANGER_SEC:.0f} วินาที\\\"\\r\\n\\t\\tdetected_summary.append(\\\"both_shoulders\\\")\\r\\n\\telif has_both_shoulders and z1_duration >= WARNING_HOLD_SEC:\\r\\n\\t\\trisk_level = \\\"WARNING\\\"\\r\\n\\t\\tactive_duration = z1_duration\\r\\n\\t\\tdetected_summary.append(\\\"both_shoulders\\\")\\r\\n\\t\\tevent_desc = \\\"ระดับเฝ้าระวัง: พบหัวไหล่ทั้ง 2 ข้างยื่นเข้าโซนราวสะพาน\\\"\\r\\n\\r\\n\\tparts_str = \\\", \\\".join(detected_summary) if detected_summary else \\\"None\\\"\\r\\n\\r\\n\\t# 4. วาดแถบสถานะลงบนภาพ\\r\\n\\tif risk_level == \\\"VEHICLE\\\":\\r\\n\\t\\tbanner_color = (0, 215, 255)\\r\\n\\t\\tstatus_text = f\\\"VEHICLE INTRUSION! | {parts_str}\\\"\\r\\n\\telif risk_level == \\\"FALLEN\\\":\\r\\n\\t\\tbanner_color = (255, 0, 255)\\r\\n\\t\\tstatus_text = f\\\"FAINTED / FALLEN! ({active_duration:.1f}s) | {parts_str}\\\"\\r\\n\\telif risk_level == \\\"DANGER\\\":\\r\\n\\t\\tbanner_color = (0, 0, 255)\\r\\n\\t\\tstatus_text = f\\\"DANGER! ({active_duration:.1f}s) | {parts_str}\\\"\\r\\n\\telif risk_level == \\\"WARNING\\\":\\r\\n\\t\\tbanner_color = (0, 165, 255)\\r\\n\\t\\tstatus_text = f\\\"WARNING ({active_duration:.1f}s) | {parts_str}\\\"\\r\\n\\telse:\\r\\n\\t\\tbanner_color = (0, 200, 0)\\r\\n\\t\\tstatus_text = \\\"STATUS: NORMAL\\\"\\r\\n\\r\\n\\tcv2.rectangle(display_img, (15, 15), (880, 65), (0, 0, 0), -1)\\r\\n\\tcv2.putText(display_img, status_text, (25, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.75, banner_color, 2)\\r\\n\\r\\n\\tframe_buffer.append(display_img.copy())\\r\\n\\r\\n\\t# 5. บันทึกและแจ้งเตือนแยก Cooldown\\r\\n\\tif risk_level != \\\"NORMAL\\\" and (now - last_alert_times[risk_level]) >= ALERT_COOLDOWN:\\r\\n\\t\\tlast_alert_times[risk_level] = now\\r\\n\\t\\tshould_send_discord = risk_level in [\\\"VEHICLE\\\", \\\"FALLEN\\\", \\\"DANGER\\\"]\\r\\n\\t\\tthreading.Thread(\\r\\n\\t\\t\\ttarget=record_and_alert_async,\\r\\n\\t\\t\\targs=(display_img.copy(), list(frame_buffer), risk_level, event_desc, active_duration, should_send_discord),\\r\\n\\t\\t\\tdaemon=True\\r\\n\\t\\t).start()\\r\\n\\r\\n\\t# 6. สตรีมภาพเข้า Web Dashboard\\r\\n\\tif (now - last_stream_time) >= 0.08:\\r\\n\\t\\tlast_stream_time = now\\r\\n\\t\\tok, buffer_jpg = cv2.imencode(\\\".jpg\\\", display_img, [int(cv2.IMWRITE_JPEG_QUALITY), 75])\\r\\n\\t\\tif ok:\\r\\n\\t\\t\\tthreading.Thread(\\r\\n\\t\\t\\t\\ttarget=send_live_stream_async,\\r\\n\\t\\t\\t\\targs=(buffer_jpg.tobytes(), risk_level, parts_str, active_duration),\\r\\n\\t\\t\\t\\tdaemon=True\\r\\n\\t\\t\\t).start()\\r\\n\\r\\n\\tpayload[\\\"risk_level\\\"] = risk_level\\r\\n\\treturn makeRespData(payload, display_img)\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/Tar/.local/bin/python3.14.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -1824,\n                \"y\": 76\n            }\n        },\n        {\n            \"id\": \"{4acd357f-844e-4411-b350-a2e3b105eaee}\",\n            \"model\": {\n                \"height\": 555,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 910\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -1577,\n                \"y\": 133\n            }\n        },\n        {\n            \"id\": \"{4c7ff8e0-4481-48df-b4be-80599b7a782e}\",\n            \"model\": {\n                \"data\": {\n                    \"curr_tap\": 0,\n                    \"draw_roi\": true,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 1.2,\n                    \"font_thickness\": 2,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"Vulkan\",\n                            \"config_name\": \"P\",\n                            \"config_path\": \"C:/Users/Tar/Downloads/New folder (2)/New folder (2)\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 0.4,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {\n                    },\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": true,\n                    \"this_config_name\": \"P\",\n                    \"thresh\": 30,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": [\n                    ]\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2546,\n                \"y\": 304\n            }\n        },\n        {\n            \"id\": \"{81c52d58-8611-45ad-adbd-ac8bf1ddceff}\",\n            \"model\": {\n                \"height\": 389,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 531,\n                \"width\": 559\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2299,\n                \"y\": 399\n            }\n        },\n        {\n            \"id\": \"{78ff8038-699d-4fbb-8909-c41597871d3d}\",\n            \"model\": {\n                \"data\": {\n                    \"count_key\": \"\",\n                    \"output_style\": \"both\",\n                    \"payload_key\": \"DeepD_C\",\n                    \"use_intersection\": true,\n                    \"zones\": [\n                        {\n                            \"alpha\": 0.3,\n                            \"color\": \"255,0,255\",\n                            \"filled\": true,\n                            \"thickness\": 3,\n                            \"zone_name\": \"Zone1\",\n                            \"zone_pts_str\": \"1022:704,624:2,1274:2,1267:686\"\n                        },\n                        {\n                            \"alpha\": 0.3,\n                            \"color\": \"182,255,0\",\n                            \"filled\": true,\n                            \"thickness\": 3,\n                            \"zone_name\": \"Zone2\",\n                            \"zone_pts_str\": \"270:699,453:5,594:2,930:702\"\n                        }\n                    ]\n                },\n                \"name\": \"ZoneCounterP\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2565,\n                \"y\": 589\n            }\n        },\n        {\n            \"id\": \"{fe15d704-38b8-474c-9504-fdd46bd36533}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"import time\\r\\nimport threading\\r\\nimport os\\r\\nimport json\\r\\nfrom collections import deque\\r\\nimport cv2\\r\\nimport numpy as np\\r\\nimport requests\\r\\n\\r\\n# ================= ตั้งค่าระบบเชื่อมต่อ CAM-02 (DeepDetect) =================\\r\\nDISCORD_WEBHOOK_URL = \\\"https://discord.com/api/webhooks/1574981821609934898/Fkye7V7yum891WsLuHGsMzpH0Otwng85XCuDypCnAdubOnb67Vanim-kAMy9cNT0JoFq\\\"\\r\\nDISCORD_NOTIFY_WARNING = False  # ตั้งเป็น True หากต้องการให้ระดับ WARNING (30%-50%) แจ้งเข้า Discord ด้วย\\r\\n\\r\\nSERVER_CAM2_LIVE_URL = \\\"http://127.0.0.1:8000/api/live_cam2\\\"\\r\\nSERVER_INCIDENT_URL = \\\"http://127.0.0.1:8000/api/incident\\\"\\r\\nBASE_DIR = r\\\"C:\\\\Users\\\\Tar\\\\Desktop\\\\BridgeDemo\\\"\\r\\nCAPTURE_DIR = os.path.join(BASE_DIR, \\\"captures\\\")\\r\\nZONE_CONFIG_PATH = os.path.join(BASE_DIR, \\\"zone_config.json\\\")\\r\\nos.makedirs(CAPTURE_DIR, exist_ok=True)\\r\\n\\r\\nPOLE_ID = \\\"เสา P8-N04 (เปรียบเทียบ DeepDetect)\\\"\\r\\nWARNING_THRESHOLD_PCT = 30.0  # เข้าโซน 30% - 50% -> WARNING (บันทึกภาพนิ่ง)\\r\\nDANGER_THRESHOLD_PCT = 50.0   # เข้าโซนมากกว่า 50% -> DANGER (บันทึกภาพนิ่ง + คลิปวิดีโอ + แจ้ง Discord)\\r\\nALERT_COOLDOWN = 15.0         # หน่วงเวลาบันทึกและส่งแจ้งเตือนซ้ำ (วินาที)\\r\\n# =========================================================================\\r\\n\\r\\nzone_enter_time = None\\r\\nlast_alert_times = {\\\"DANGER\\\": 0, \\\"WARNING\\\": 0}\\r\\nlast_stream_time = 0\\r\\nframe_buffer = deque(maxlen=60)\\r\\n\\r\\ncurrent_polygon = np.array([[930, 150], [1050, 150], [1200, 680], [1020, 680]], dtype=np.int32)\\r\\nlast_config_mtime = 0\\r\\ncached_mask = None\\r\\ncached_shape = None\\r\\n\\r\\ndef refresh_zone_if_updated():\\r\\n\\t\\\"\\\"\\\"อ่านพิกัดโซนใหม่จาก zone_config.json อัตโนมัติเมื่อผู้ใช้คลิกวาดบนหน้าเว็บ\\\"\\\"\\\"\\r\\n\\tglobal current_polygon, last_config_mtime, cached_mask\\r\\n\\tif os.path.exists(ZONE_CONFIG_PATH):\\r\\n\\t\\ttry:\\r\\n\\t\\t\\tmtime = os.path.getmtime(ZONE_CONFIG_PATH)\\r\\n\\t\\t\\tif mtime != last_config_mtime:\\r\\n\\t\\t\\t\\twith open(ZONE_CONFIG_PATH, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\r\\n\\t\\t\\t\\t\\tdata = json.load(f)\\r\\n\\t\\t\\t\\t\\tpts = data.get(\\\"points\\\", [])\\r\\n\\t\\t\\t\\t\\tif isinstance(pts, list) and len(pts) >= 3:\\r\\n\\t\\t\\t\\t\\t\\tcurrent_polygon = np.array(pts, dtype=np.int32)\\r\\n\\t\\t\\t\\t\\t\\tlast_config_mtime = mtime\\r\\n\\t\\t\\t\\t\\t\\tcached_mask = None\\r\\n\\t\\texcept Exception:\\r\\n\\t\\t\\tpass\\r\\n\\r\\ndef get_zone_mask(img_shape):\\r\\n\\tglobal cached_mask, cached_shape\\r\\n\\trefresh_zone_if_updated()\\r\\n\\th, w = img_shape[:2]\\r\\n\\tif cached_mask is None or cached_shape != (h, w):\\r\\n\\t\\tmask = np.zeros((h, w), dtype=np.uint8)\\r\\n\\t\\tcv2.fillPoly(mask, [current_polygon], 255)\\r\\n\\t\\tcached_mask = mask\\r\\n\\t\\tcached_shape = (h, w)\\r\\n\\treturn cached_mask\\r\\n\\r\\ndef calc_overlap_percentage(x, y, w, h, zone_mask):\\r\\n\\timg_h, img_w = zone_mask.shape\\r\\n\\tx1 = max(0, int(x))\\r\\n\\ty1 = max(0, int(y))\\r\\n\\tx2 = min(img_w, int(x + w))\\r\\n\\ty2 = min(img_h, int(y + h))\\r\\n\\r\\n\\tbox_w = max(0, x2 - x1)\\r\\n\\tbox_h = max(0, y2 - y1)\\r\\n\\ttotal_area = box_w * box_h\\r\\n\\tif total_area == 0:\\r\\n\\t\\treturn 0.0\\r\\n\\r\\n\\toverlap_pixels = np.count_nonzero(zone_mask[y1:y2, x1:x2])\\r\\n\\treturn (overlap_pixels / float(total_area)) * 100.0\\r\\n\\r\\ndef send_cam2_stream_async(jpg_bytes, risk_level, person_count, max_pct, duration):\\r\\n\\ttry:\\r\\n\\t\\trequests.post(\\r\\n\\t\\t\\tSERVER_CAM2_LIVE_URL,\\r\\n\\t\\t\\tdata={\\r\\n\\t\\t\\t\\t\\\"risk_level\\\": risk_level,\\r\\n\\t\\t\\t\\t\\\"is_alert\\\": str(risk_level in [\\\"WARNING\\\", \\\"DANGER\\\"]),\\r\\n\\t\\t\\t\\t\\\"person_count\\\": person_count,\\r\\n\\t\\t\\t\\t\\\"max_pct\\\": round(max_pct, 1),\\r\\n\\t\\t\\t\\t\\\"duration\\\": round(duration, 2),\\r\\n\\t\\t\\t\\t\\\"pole_id\\\": POLE_ID\\r\\n\\t\\t\\t},\\r\\n\\t\\t\\tfiles={\\\"frame\\\": (\\\"cam2.jpg\\\", jpg_bytes, \\\"image/jpeg\\\")},\\r\\n\\t\\t\\ttimeout=0.3\\r\\n\\t\\t)\\r\\n\\texcept Exception:\\r\\n\\t\\tpass\\r\\n\\r\\ndef log_cam2_incident_async(snapshot_img, buffered_frames, risk_level, person_count, max_pct, duration):\\r\\n\\ttry:\\r\\n\\t\\tts_file = time.strftime(\\\"%Y%m%d_%H%M%S\\\")\\r\\n\\t\\tts_read = time.strftime(\\\"%Y-%m-%d %H:%M:%S\\\")\\r\\n\\t\\timg_name = f\\\"cam2_{risk_level.lower()}_{ts_file}.jpg\\\"\\r\\n\\t\\timg_path = os.path.join(CAPTURE_DIR, img_name)\\r\\n\\r\\n\\t\\t# 1. บันทึกภาพนิ่ง (.jpg)\\r\\n\\t\\tcv2.imwrite(img_path, snapshot_img)\\r\\n\\r\\n\\t\\t# 2. บันทึกคลิปวิดีโอ (.webm) เฉพาะเมื่อระดับ DANGER (> 50%)\\r\\n\\t\\tvid_name = \\\"\\\"\\r\\n\\t\\tif risk_level == \\\"DANGER\\\" and len(buffered_frames) > 0:\\r\\n\\t\\t\\th, w, _ = buffered_frames[0].shape\\r\\n\\t\\t\\tvid_name = f\\\"cam2_danger_{ts_file}.webm\\\"\\r\\n\\t\\t\\tvid_path = os.path.join(CAPTURE_DIR, vid_name)\\r\\n\\t\\t\\tout_vid = cv2.VideoWriter(vid_path, cv2.VideoWriter_fourcc(*'VP80'), 12.0, (w, h))\\r\\n\\r\\n\\t\\t\\tif not out_vid.isOpened():\\r\\n\\t\\t\\t\\tvid_name = f\\\"cam2_danger_{ts_file}.mp4\\\"\\r\\n\\t\\t\\t\\tvid_path = os.path.join(CAPTURE_DIR, vid_name)\\r\\n\\t\\t\\t\\tout_vid = cv2.VideoWriter(vid_path, cv2.VideoWriter_fourcc(*'avc1'), 12.0, (w, h))\\r\\n\\r\\n\\t\\t\\tif out_vid.isOpened():\\r\\n\\t\\t\\t\\tfor f in buffered_frames:\\r\\n\\t\\t\\t\\t\\tout_vid.write(f)\\r\\n\\t\\t\\t\\tout_vid.release()\\r\\n\\t\\t\\telse:\\r\\n\\t\\t\\t\\tvid_name = \\\"\\\"\\r\\n\\r\\n\\t\\t# 3. บันทึกลงฐานข้อมูล SQLite\\r\\n\\t\\tif risk_level == \\\"DANGER\\\":\\r\\n\\t\\t\\tevent_desc = f\\\"[DeepDetect] อันตราย: กรอบ person เข้าโซน {max_pct:.1f}% (> {DANGER_THRESHOLD_PCT:.0f}%)\\\"\\r\\n\\t\\telse:\\r\\n\\t\\t\\tevent_desc = f\\\"[DeepDetect] เฝ้าระวัง: กรอบ person เข้าโซน {max_pct:.1f}% (>= {WARNING_THRESHOLD_PCT:.0f}%)\\\"\\r\\n\\r\\n\\t\\trequests.post(SERVER_INCIDENT_URL, json={\\r\\n\\t\\t\\t\\\"timestamp\\\": ts_read,\\r\\n\\t\\t\\t\\\"camera_id\\\": \\\"CAM-02 (DeepDetect)\\\",\\r\\n\\t\\t\\t\\\"pole_id\\\": POLE_ID,\\r\\n\\t\\t\\t\\\"risk_level\\\": risk_level,\\r\\n\\t\\t\\t\\\"event_type\\\": event_desc,\\r\\n\\t\\t\\t\\\"duration\\\": duration,\\r\\n\\t\\t\\t\\\"snapshot_file\\\": img_name,\\r\\n\\t\\t\\t\\\"video_file\\\": vid_name\\r\\n\\t\\t}, timeout=2.0)\\r\\n\\r\\n\\t\\t# 4. ส่งแจ้งเตือนพร้อมรูปภาพเข้า Discord\\r\\n\\t\\tshould_send_discord = (risk_level == \\\"DANGER\\\") or (risk_level == \\\"WARNING\\\" and DISCORD_NOTIFY_WARNING)\\r\\n\\t\\tif should_send_discord and DISCORD_WEBHOOK_URL.startswith(\\\"http\\\"):\\r\\n\\t\\t\\theader_tag = \\\"🚨 **[แจ้งเหตุอันตราย - CAM-02 DeepDetect]**\\\" if risk_level == \\\"DANGER\\\" else \\\"⚠️ **[แจ้งเหตุเฝ้าระวัง - CAM-02 DeepDetect]**\\\"\\r\\n\\t\\t\\tmsg = (\\r\\n\\t\\t\\t\\tf\\\"{header_tag}\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"📍 **พิกัดจุดเกิดเหตุ:** `{POLE_ID}` (กล้อง `CAM-02`)\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"📊 **พื้นที่ล้ำโซน:** `{max_pct:.1f}%` (พบ `{person_count}` คน | ต่อเนื่อง `{duration:.1f}` วินาที)\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"⚠️ **รายละเอียด:** {event_desc}\\\\n\\\"\\r\\n\\t\\t\\t\\tf\\\"🕒 **เวลา:** `{ts_read}`\\\"\\r\\n\\t\\t\\t)\\r\\n\\t\\t\\twith open(img_path, \\\"rb\\\") as f:\\r\\n\\t\\t\\t\\trequests.post(\\r\\n\\t\\t\\t\\t\\tDISCORD_WEBHOOK_URL,\\r\\n\\t\\t\\t\\t\\tdata={\\\"content\\\": msg},\\r\\n\\t\\t\\t\\t\\tfiles={\\\"file\\\": (img_name, f, \\\"image/jpeg\\\")},\\r\\n\\t\\t\\t\\t\\ttimeout=5.0\\r\\n\\t\\t\\t\\t)\\r\\n\\r\\n\\t\\tprint(f\\\"[CAM-02 {risk_level}] บันทึกและแจ้งเตือน (Overlap {max_pct:.1f}%) สำเร็จ\\\")\\r\\n\\texcept Exception as e:\\r\\n\\t\\tprint(\\\"[CAM-02 ERROR]\\\", e)\\r\\n\\r\\ndef handle_request(req):\\r\\n\\tglobal zone_enter_time, last_alert_times, last_stream_time\\r\\n\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\tif img is None:\\r\\n\\t\\treturn makeRespData(payload, img)\\r\\n\\r\\n\\tdisplay_img = np.ascontiguousarray(np.array(img, dtype=np.uint8)).copy()\\r\\n\\tzone_mask = get_zone_mask(display_img.shape)\\r\\n\\r\\n\\tobjects = payload.get(\\\"DeepDetect\\\", {}).get(\\\"objects\\\", [])\\r\\n\\tdanger_person_count = 0\\r\\n\\twarning_person_count = 0\\r\\n\\tmax_overlap_pct = 0.0\\r\\n\\r\\n\\tfor obj in objects:\\r\\n\\t\\tobj_name = str(obj.get(\\\"name\\\", \\\"\\\")).strip().lower()\\r\\n\\t\\tif obj_name != \\\"person\\\":\\r\\n\\t\\t\\tcontinue\\r\\n\\r\\n\\t\\tx = int(obj.get(\\\"x\\\", 0))\\r\\n\\t\\ty = int(obj.get(\\\"y\\\", 0))\\r\\n\\t\\tw = int(obj.get(\\\"w\\\", 0))\\r\\n\\t\\th = int(obj.get(\\\"h\\\", 0))\\r\\n\\r\\n\\t\\toverlap_pct = calc_overlap_percentage(x, y, w, h, zone_mask)\\r\\n\\t\\tif overlap_pct > max_overlap_pct:\\r\\n\\t\\t\\tmax_overlap_pct = overlap_pct\\r\\n\\r\\n\\t\\tif overlap_pct > DANGER_THRESHOLD_PCT:\\r\\n\\t\\t\\tdanger_person_count += 1\\r\\n\\t\\t\\tcv2.rectangle(display_img, (x, y), (x + w, y + h), (0, 0, 255), 3)\\r\\n\\t\\t\\tcv2.putText(display_img, f\\\"DANGER! {overlap_pct:.1f}% in Zone\\\", (x, max(25, y - 10)),\\r\\n\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 0, 255), 2)\\r\\n\\t\\telif overlap_pct >= WARNING_THRESHOLD_PCT:\\r\\n\\t\\t\\twarning_person_count += 1\\r\\n\\t\\t\\tcv2.rectangle(display_img, (x, y), (x + w, y + h), (0, 165, 255), 3)\\r\\n\\t\\t\\tcv2.putText(display_img, f\\\"WARNING! {overlap_pct:.1f}% in Zone\\\", (x, max(25, y - 10)),\\r\\n\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 165, 255), 2)\\r\\n\\t\\telif overlap_pct > 0:\\r\\n\\t\\t\\tcv2.rectangle(display_img, (x, y), (x + w, y + h), (0, 215, 255), 2)\\r\\n\\t\\t\\tcv2.putText(display_img, f\\\"In Zone: {overlap_pct:.1f}%\\\", (x, max(25, y - 10)),\\r\\n\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 215, 255), 2)\\r\\n\\r\\n\\tif danger_person_count > 0:\\r\\n\\t\\trisk_level = \\\"DANGER\\\"\\r\\n\\t\\tactive_count = danger_person_count\\r\\n\\t\\tzone_color = (0, 0, 255)\\r\\n\\telif warning_person_count > 0:\\r\\n\\t\\trisk_level = \\\"WARNING\\\"\\r\\n\\t\\tactive_count = warning_person_count\\r\\n\\t\\tzone_color = (0, 165, 255)\\r\\n\\telse:\\r\\n\\t\\trisk_level = \\\"NORMAL\\\"\\r\\n\\t\\tactive_count = 0\\r\\n\\t\\tzone_color = (0, 255, 0)\\r\\n\\r\\n\\tcv2.polylines(display_img, [current_polygon], isClosed=True, color=zone_color, thickness=2)\\r\\n\\r\\n\\tnow = time.time()\\r\\n\\tduration = 0.0\\r\\n\\tif risk_level != \\\"NORMAL\\\":\\r\\n\\t\\tif zone_enter_time is None:\\r\\n\\t\\t\\tzone_enter_time = now\\r\\n\\t\\tduration = now - zone_enter_time\\r\\n\\telse:\\r\\n\\t\\tzone_enter_time = None\\r\\n\\r\\n\\tif risk_level == \\\"DANGER\\\":\\r\\n\\t\\tbanner_color = (0, 0, 255)\\r\\n\\t\\tstatus_text = f\\\"CAM-02 DANGER! Area: {max_overlap_pct:.1f}% (> {DANGER_THRESHOLD_PCT:.0f}%) | {duration:.1f}s\\\"\\r\\n\\telif risk_level == \\\"WARNING\\\":\\r\\n\\t\\tbanner_color = (0, 165, 255)\\r\\n\\t\\tstatus_text = f\\\"CAM-02 WARNING! Area: {max_overlap_pct:.1f}% (>= {WARNING_THRESHOLD_PCT:.0f}%) | {duration:.1f}s\\\"\\r\\n\\telse:\\r\\n\\t\\tbanner_color = (0, 200, 0)\\r\\n\\t\\tstatus_text = f\\\"CAM-02 NORMAL | Max Area: {max_overlap_pct:.1f}%\\\"\\r\\n\\r\\n\\tcv2.rectangle(display_img, (15, 15), (880, 65), (0, 0, 0), -1)\\r\\n\\tcv2.putText(display_img, status_text, (25, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.72, banner_color, 2)\\r\\n\\r\\n\\tframe_buffer.append(display_img.copy())\\r\\n\\r\\n\\tif risk_level != \\\"NORMAL\\\" and (now - last_alert_times[risk_level]) >= ALERT_COOLDOWN:\\r\\n\\t\\tlast_alert_times[risk_level] = now\\r\\n\\t\\tthreading.Thread(\\r\\n\\t\\t\\ttarget=log_cam2_incident_async,\\r\\n\\t\\t\\targs=(display_img.copy(), list(frame_buffer), risk_level, active_count, max_overlap_pct, duration),\\r\\n\\t\\t\\tdaemon=True\\r\\n\\t\\t).start()\\r\\n\\r\\n\\tif (now - last_stream_time) >= 0.08:\\r\\n\\t\\tlast_stream_time = now\\r\\n\\t\\tok, buffer_jpg = cv2.imencode(\\\".jpg\\\", display_img, [int(cv2.IMWRITE_JPEG_QUALITY), 75])\\r\\n\\t\\tif ok:\\r\\n\\t\\t\\tthreading.Thread(\\r\\n\\t\\t\\t\\ttarget=send_cam2_stream_async,\\r\\n\\t\\t\\t\\targs=(buffer_jpg.tobytes(), risk_level, active_count, max_overlap_pct, duration),\\r\\n\\t\\t\\t\\tdaemon=True\\r\\n\\t\\t\\t).start()\\r\\n\\r\\n\\tpayload[\\\"cam2_risk_level\\\"] = risk_level\\r\\n\\tpayload[\\\"cam2_overlap_pct\\\"] = round(max_overlap_pct, 1)\\r\\n\\treturn makeRespData(payload, display_img)\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/Tar/.local/bin/python3.14.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -2223,\n                \"y\": 266\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -2742.253630185999,\n        \"flow_view_pos_y\": -3.556963087023007,\n        \"flow_view_zoom_factor\": 0.4665073802097333,\n        \"scene_version\": 1\n    }\n}\n",
            "name": "Main"
        }
    ]
}
